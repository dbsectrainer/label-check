# Copy to .env and fill in. Never commit .env.
# server.js does not load .env files itself, so export these in your shell
# (e.g. `set -a; source .env; set +a; node server.js`) or add them in Vercel's project settings.

# Required: label reading returns 503 without it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: defaults to claude-haiku-5-5 (fastest tier).
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: leave empty for same-origin only (no CORS headers).
# Set to your GitHub Pages URL if the frontend is hosted separately from the API.
ALLOWED_ORIGIN=

# Optional: requests per client per minute to /api/extract (default 120).
RATE_LIMIT_PER_MIN=120

# Optional, server.js only: port to listen on (default 3000).
PORT=3000
